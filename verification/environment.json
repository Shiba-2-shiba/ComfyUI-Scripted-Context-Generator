{
  "schema_version": 1,
  "environment_id": "prompt-quality-parity-v1",
  "repositories": {
    "comfyui": {
      "path": "ComfyUI",
      "remote": "https://github.com/comfyanonymous/ComfyUI.git",
      "ref": "v0.32.0",
      "commit": "c2bcbecd82ec5ae66594340b395c24ef0217b238"
    },
    "comfyui_frontend": {
      "path": "ComfyUI_frontend",
      "remote": "https://github.com/Comfy-Org/ComfyUI_frontend.git",
      "ref": "v1.46.3",
      "commit": "d05eadba974a4d33c7749fc4bd880cecf7111790"
    }
  },
  "dependency_restore": {
    "comfyui": "python -m pip install -r ComfyUI/requirements.txt",
    "comfyui_frontend": "corepack pnpm --dir ComfyUI_frontend install --frozen-lockfile"
  },
  "sink": {
    "version": 1,
    "source": "verification/comfyui_sink",
    "install_path": "ComfyUI/custom_nodes/prompt_quality_verification_sink",
    "node_type": "PromptQualityVerificationSink"
  },
  "parity": {
    "workflow": "verification/fixtures/prompt_parity_workflow.json",
    "sentinel_seeds": [0, 1, 2, 3, 5, 8, 13, 21],
    "required_outputs": ["final_context", "raw_prompt", "cleaned_prompt"],
    "command": "python tools/verify_prompt_execution_parity.py --environment verification/environment.json"
  }
}
