      "identity.male_pronoun_drift_count": 0,
      "identity.missing_female_protagonist_count": 0,
      "identity.non_girl_female_term_count": 0,
      "identity.other_person_solo_conflict_count": 0,
      "identity.person_demographic_descriptor_count": 0,
      "runtime.deterministic_replay_mismatch_count": 0,
      "runtime.error_count": 0,
      "runtime.record_contract_error_count": 0
    }
  },
  "consistency_rule_annotations": {
    "indoor|under the sky": {"domain": "location_action_object", "reason_code": "indoor_outdoor_scene_conflict"},
    "evening|midday": {"domain": "location_action_object", "reason_code": "night_daylight_scene_conflict"},
    "evening|morning": {"domain": "location_action_object", "reason_code": "night_daylight_scene_conflict"},
    "night|blue sky": {"domain": "location_action_object", "reason_code": "night_daylight_scene_conflict"},
    "night|midday": {"domain": "location_action_object", "reason_code": "night_daylight_scene_conflict"},
    "night|morning": {"domain": "location_action_object", "reason_code": "night_daylight_scene_conflict"},
    "night|sunny": {"domain": "location_action_object", "reason_code": "night_daylight_scene_conflict"},
    "rain|dry ground": {"domain": "clothing_tpo_weather", "reason_code": "rain_surface_weather_conflict"},
    "snow|hot day": {"domain": "clothing_tpo_weather", "reason_code": "snow_temperature_weather_conflict"},
    "winter|warm sun": {"domain": "clothing_tpo_weather", "reason_code": "winter_temperature_weather_conflict"}
