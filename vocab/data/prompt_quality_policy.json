    "dimension_authority": {
      "consistency": "affected_seed_pairwise",
      "diversity": "current_source_corpus_confirmation",
      "image_prompt_suitability": "selected_pairwise",
      "naturalness": "selected_pairwise",
      "protagonist_clarity": "selected_pairwise",
      "redundancy": "selected_pairwise"
    },
    "hard_defect_codes": [
      "clothing_tpo_weather_conflict",
      "consistency_rule_conflict",
      "deterministic_replay_mismatch",
      "location_action_object_conflict",
      "male_pronoun_drift",
      "missing_female_protagonist",
      "mood_action_garnish_conflict",
      "non_girl_female_term",
      "other_person_solo_conflict",
      "person_demographic_descriptor",
      "runtime_error"
    ],
    "minimum_valid_vote_fraction": 0.9,
    "minimum_valid_votes_cap": 36,
    "sampling_strategy": "comparison_bound_affected_first_deterministic_20",
    "candidate_only_hard_defect_max": 0,
    "dimensions": {
      "consistency": {"max_worse_rate": 0.1, "min_improvement_support": 0.65},
      "image_prompt_suitability": {"hard_defect_max": 0, "max_worse_rate": 0.1},
      "naturalness": {"max_worse_rate": 0.1, "min_improvement_support": 0.65},
      "protagonist_clarity": {"hard_defect_max": 0, "max_worse_rate": 0.1}
    },
    "independent_lanes": 2,
    "guard_dimension_contract": {
      "max_candidate_worse_rate": 0.1,
      "minimum_valid_votes": 0,
      "require_improvement": false,
      "require_lane_direction_agreement": false
    },
    "hypothesis_scoped": true,
    "minimum_valid_votes_per_required_dimension": "computed_before_voting",
    "paired_samples": 20,
    "require_lane_direction_agreement": true,
    "require_prompt_and_rubric_hashes": true,
    "side_assignment": "deterministic_blind_randomization",
    "target_dimension_contract": {
      "max_candidate_worse_rate": 0.1,
      "min_improvement_support": 0.65,
      "require_lane_direction_agreement": true
    }
  },
  "status": "frozen",
  "threshold_review": {
