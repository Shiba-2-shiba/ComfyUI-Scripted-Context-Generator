    "identity.non_girl_female_term_count": {"direction": "decrease"},
    "identity.other_person_solo_conflict_count": {"direction": "decrease"},
    "identity.person_demographic_descriptor_count": {"direction": "decrease"},
    "identity.single_female_coverage": {"direction": "increase"},
    "naturalness.punctuation_anomaly_count": {"direction": "decrease"},
    "naturalness.repeated_ngram_count": {"direction": "decrease"},
    "runtime.deterministic_replay_mismatch_count": {"direction": "decrease"},
    "runtime.fallback_rate": {"direction": "decrease"}
