    "consistency_rule_conflict": "critical",
    "context_size_exceeded": "high",
    "deterministic_replay_mismatch": "critical",
    "duplicate_protagonist_mention": "high",
    "exact_duplicate_prompt": "medium",
    "high_comma_density": "medium",
    "high_fallback_rate": "high",
    "location_action_object_conflict": "critical",
    "male_pronoun_drift": "critical",
    "missing_female_protagonist": "critical",
    "non_girl_female_term": "critical",
    "mood_action_garnish_conflict": "critical",
    "normalized_duplicate_prompt": "medium",
    "other_person_solo_conflict": "critical",
    "person_demographic_descriptor": "critical",
    "prompt_length_outlier": "medium",
    "punctuation_anomaly": "medium",
    "repeated_ngram": "medium",
    "runtime_error": "critical",
    "runtime_warning": "medium",
    "semantic_family_repetition": "medium",
    "sentence_fragment": "medium"
