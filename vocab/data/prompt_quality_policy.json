{
  "analyzer": {
    "comma_density_max": 0.12,
    "context_json_bytes_max": 262144,
    "female_terms": ["girl"],
    "disallowed_female_terms": ["female", "lady", "woman", "women"],
    "fallback_rate_max": 0.05,
    "male_terms": ["boy", "he", "him", "his", "male", "man"],
    "max_duplicate_subject_terms": 1,
    "prompt_length_words_max": 220,
    "prompt_length_words_min": 12,
    "repeated_ngram_min_occurrences": 3,
    "semantic_family_max_mentions": 2
  },
  "cohort": {
    "control_count": 64,
    "exploration_count": 16,
    "formal_promotion_min_samples": 80,
    "promotion_scope": "control64"
  },
  "comparison": {
    "effect_sizes": {
      "defect_count_min_reduction": 2,
      "defect_rate_min_relative_improvement": 0.1,
      "diversity_min_relative_improvement": 0.05
    },
    "guards": {
      "exact_duplicate_rate_must_not_increase": true,
      "fallback_rate_must_not_increase": true,
      "max_absolute_rate_regression": 0.02,
      "policy_thresholds_must_remain_satisfied": true
    },
    "hard_gates": {
      "consistency.hard_conflict_count": 0,
      "consistency.domains.clothing_tpo_weather.hard_conflict_count": 0,
      "consistency.domains.location_action_object.hard_conflict_count": 0,
