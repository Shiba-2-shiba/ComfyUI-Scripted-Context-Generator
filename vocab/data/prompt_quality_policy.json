    "consistency.domains.mood_action_garnish.hard_conflict_count": {"direction": "decrease"},
    "consistency.hard_conflict_count": {"direction": "decrease"},
    "diversity.exact_unique_ratio": {"direction": "increase"},
    "diversity.syntax_entropy": {"direction": "increase"},
    "identity.duplicate_protagonist_mention_count": {"direction": "decrease"},
    "identity.male_pronoun_drift_count": {"direction": "decrease"},
